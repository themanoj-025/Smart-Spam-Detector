# Smart-Spam-Detector - Environment Template
# Copy to .env and fill in real values. NEVER commit .env.

# API Key for FastAPI authentication (optional).
# When set, all /predict endpoints require: Authorization: Bearer <key>
SPAM_API_KEY=

# Log level: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# Comma-separated list of allowed CORS origins (api service)
# CORS_ORIGINS=http://localhost:8000,http://localhost:8501

# MLflow tracking (optional — enables experiment tracking & model registry)
# MLFLOW_TRACKING_URI=http://localhost:5000
# MLFLOW_EXPERIMENT_NAME=smart-spam-detector
