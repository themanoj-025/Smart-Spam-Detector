# ==============================================================================
# Smart-Spam-Detector - Security & Production .gitignore
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. SECRETS & ENVIRONMENT VARIABLES (CRITICAL)
# ------------------------------------------------------------------------------
.env
.env.*
*.env
.env.local
.env.*.local
.env.development
.env.test
.env.staging
.env.production
!.env.example
!.env.template
!.env.sample

# Streamlit secrets (NEVER COMMIT)
.streamlit/secrets.toml
.streamlit/secrets.toml.local
!.streamlit/secrets.toml.example
!.streamlit/secrets.toml.template

# Private keys, certificates & credentials
*.pem
*.key
*.keystore
*.jks
*.p12
*.pfx
*.pkcs12
*.cer
*.crt
*.der
*.id_rsa
id_rsa*
id_ed25519*
id_ecdsa*
id_dsa*

# Cloud & service credentials
credentials.json
*credentials*.json
client_secret*.json
client_secrets*.json
service-account*.json
service_account*.json
serviceAccountKey*.json
google-services.json
google-credentials*.json
GoogleService-Info.plist
.aws/
.azure/
.gcp/
gcloud/
.act-secrets
*.secrets.*
.secrets
*.publishsettings
*.tfstate
*.tfstate.*
.terraform/
.terraform.lock.hcl
kubeconfig
*.kubeconfig
.kube/

# Password vaults & cryptographic stores
*.kdbx

# Authentication tokens & configs
.netrc
.pypirc
.npmrc
*token*.json
token.pickle
auth*.json

# ------------------------------------------------------------------------------
# 2. PYTHON RUNTIME, BUILDS & VIRTUAL ENVIRONMENTS
# ------------------------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
dist/
build/
*.egg-info/
*.egg

# Virtual environments
.venv/
venv/
ENV/
env/
.venv*/
.venv2/
env.bak/
venv.bak/

# ------------------------------------------------------------------------------
# 3. MACHINE LEARNING & OUTPUT ARTIFACTS
# ------------------------------------------------------------------------------
outputs/
data/models/
outputs/*/
!outputs/
!outputs/2026-06-01_18-54-30/

# ML models
*.pkl
*.joblib
*.h5
*.pt
*.ckpt
*.parquet
mlruns/

# Classification history
history/classifications.db

# ------------------------------------------------------------------------------
# 4. LOGS & DATABASE FILES
# ------------------------------------------------------------------------------
logs/
*.log
*.dump
*.stackdump
*.db
*.db-shm
*.db-wal
*.db-journal
*.sqlite
*.sqlite3
*.sql.gz
*.rdb

# ------------------------------------------------------------------------------
# 5. TESTING & CODE QUALITY
# ------------------------------------------------------------------------------
.cache/
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
.coverage.*
htmlcov/
coverage.xml
radar_balance.txt

# ------------------------------------------------------------------------------
# 6. IDE, EDITORS & JUPYTER
# ------------------------------------------------------------------------------
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
.vscode/*.local.*
.vscode/mcp.json
.idea/
*.swp
*.swo
*~
.ipynb_checkpoints/
*.ipynb
=*

# ------------------------------------------------------------------------------
# 7. OS FILES & TEMPORARIES
# ------------------------------------------------------------------------------
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini
$RECYCLE.BIN/
*.tmp
*.temp
*.bak

# Node.js
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# =====================================================================
# KEEP: AI provenance & transparency files — must remain visible
# =====================================================================
!AI_DISCLOSURE.md
!AI_USAGE.md
!PROMPTS.md
!AGENTS.md
!CLAUDE.md
!GEMINI.md
!.cursorrules
!.github/copilot-instructions.md
!.claude/commands/
!.claude/commands/**
!.claude/agents/
!.claude/agents/**
!.claude/settings.json
!docs/ai/
!docs/ai/**
!.ai/
!.ai/**
!ai-provenance.json
!.gitmessage
!CITATION.cff
