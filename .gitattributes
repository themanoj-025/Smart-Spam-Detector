# Auto-detect text files and normalize line endings
* text=auto eol=lf

# Python source
*.py text diff=python

# Jupyter notebooks
*.ipynb text diff=jupyter

# HTML templates
*.html text diff=html

# CSS stylesheets
*.css text

# JavaScript
*.js text
*.ts text
*.jsx text
*.tsx text

# Markdown documentation
*.md text
*.rst text

# Config files
*.yml text
*.yaml text
*.toml text
*.json text
*.cfg text
*.ini text

# Security: prevent secret files from appearing in diffs if accidentally created
*.env -diff
*.pem -diff
*.key -diff
*.cert -diff
*.p12 -diff
*.pfx -diff
*.pkcs12 -diff

# Shell / batch scripts
*.sh text eol=lf
*.bat text eol=crlf
*.ps1 text eol=crlf

# Docker
Dockerfile text
Dockerfile.* text
.dockerignore text

# Requirements
requirements.txt text
requirements-dev.txt text
runtime.txt text
packages.txt text

# Project config
pyproject.toml text
LICENSE text

# Binary / ML model files - don't modify
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.pkl binary
*.pickle binary
*.joblib binary
*.npy binary
*.npz binary
*.db binary
*.sqlite binary
*.sqlite3 binary
*.zip binary
